          "type": "array"
        },
        "predict_count": {
          "minimum": 0,
          "title": "Predict Count",
          "type": "integer"
        },
        "tool_count": {
          "minimum": 0,
          "title": "Tool Count",
          "type": "integer"
        },
        "untruncated_output": {
          "title": "Untruncated Output",
          "type": "string"
        },
        "usage": {
          "$ref": "#/$defs/PredictRLMUsage"
        }

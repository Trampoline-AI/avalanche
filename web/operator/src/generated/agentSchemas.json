          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "name",
        "annotation",
        "description"
      ],
      "title": "FieldDeclaration",
      "type": "object"
    },
    "IterationRecorded": {
      "additionalProperties": false,

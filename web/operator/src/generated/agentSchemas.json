{
  "$defs": {
    "AgentDeclaration": {
      "additionalProperties": false,
      "description": "Everything discovery publishes about one agent step.\n\n``tools`` are the step's own tools; tools a runtime adds, such as PredictRLM\nskill tools, are in its ``runtime`` section.",
      "properties": {
        "runtime": {
          "$ref": "#/$defs/PredictRLMDeclaration"
        },
        "signature": {
          "$ref": "#/$defs/SignatureDeclaration"
        },
        "tools": {
          "items": {
            "$ref": "#/$defs/ToolDeclaration"
          },
          "title": "Tools",
          "type": "array"
        }
      },
      "required": [
        "signature",
        "tools",
        "runtime"
      ],
      "title": "AgentDeclaration",
      "type": "object"
    },
    "AgentLiveEvent": {
      "additionalProperties": false,
      "description": "One live event of an agent invocation, as the operator stores and serves it.",
      "properties": {
        "common": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "code.generated": "#/$defs/CodeGenerated",
                  "model.finished": "#/$defs/ModelFinished",
                  "model.started": "#/$defs/ModelStarted",
                  "tool.finished": "#/$defs/ToolFinished",
                  "tool.started": "#/$defs/ToolStarted",
                  "turn.finished": "#/$defs/TurnFinished"
                },
                "propertyName": "kind"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/TurnFinished"
                },
                {
                  "$ref": "#/$defs/ModelStarted"
                },
                {
                  "$ref": "#/$defs/ModelFinished"
                },
                {
                  "$ref": "#/$defs/ToolStarted"
                },
                {
                  "$ref": "#/$defs/ToolFinished"
                },
                {
                  "$ref": "#/$defs/CodeGenerated"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "title": "Common"
        },
        "invocation_id": {
          "minLength": 1,
          "title": "Invocation Id",
          "type": "string"
        },
        "kind": {
          "const": "event",
          "default": "event",
          "title": "Kind",
          "type": "string"
        },
        "native": {
          "discriminator": {
            "mapping": {
              "artifact.collected": "#/$defs/Lifecycle",
              "artifact.mounted": "#/$defs/Lifecycle",
              "code.executed": "#/$defs/CodeExecuted",
              "code.generated": "#/$defs/Correlated",
              "input.prepared": "#/$defs/Lifecycle",
              "iteration.recorded": "#/$defs/IterationRecorded",
              "output.materialized": "#/$defs/Lifecycle",
              "output.reserved": "#/$defs/Lifecycle",
              "packages.installed": "#/$defs/Lifecycle",
              "predict.finished": "#/$defs/Correlated",
              "predict.started": "#/$defs/PredictStarted",
              "run.cancelled": "#/$defs/RunEnded",
              "run.failed": "#/$defs/RunEnded",
              "run.started": "#/$defs/RunStarted",
              "run.succeeded": "#/$defs/RunSucceeded",
              "session.finalize_failed": "#/$defs/Lifecycle",
              "session.finalized": "#/$defs/Lifecycle",
              "session.release_failed": "#/$defs/Lifecycle",
              "session.released": "#/$defs/Lifecycle",
              "session.started": "#/$defs/Lifecycle",
              "tool.finished": "#/$defs/Correlated",
              "tool.started": "#/$defs/Correlated"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/RunStarted"
            },
            {
              "$ref": "#/$defs/Lifecycle"
            },
            {
              "$ref": "#/$defs/IterationRecorded"
            },
            {
              "$ref": "#/$defs/PredictStarted"
            },
            {
              "$ref": "#/$defs/Correlated"
            },
            {
              "$ref": "#/$defs/CodeExecuted"
            },
            {
              "$ref": "#/$defs/RunSucceeded"
            },
            {
              "$ref": "#/$defs/RunEnded"
            }
          ],
          "title": "Native"
        },
        "runtime_kind": {
          "const": "predict_rlm",
          "title": "Runtime Kind",
          "type": "string"
        },
        "schema_version": {
          "const": 2,
          "default": 2,
          "title": "Schema Version",
          "type": "integer"
        },
        "sequence": {
          "exclusiveMinimum": 0,
          "title": "Sequence",
          "type": "integer"
        },
        "timestamp_ns": {
          "minimum": 0,
          "title": "Timestamp Ns",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "schema_version",
        "invocation_id",
        "sequence",
        "timestamp_ns",
        "runtime_kind",
        "common",
        "native"
      ],
      "title": "AgentLiveEvent",
      "type": "object"
    },
    "AgentTrace": {
      "additionalProperties": false,
      "description": "The complete trace of one agent invocation.\n\nWhen ``turns_streamed`` is true, turns travelled as live events and the\nrecord carries none; the header still states how many there were.",
      "properties": {
        "header": {
          "$ref": "#/$defs/AgentTraceHeader"
        },
        "native": {
          "$ref": "#/$defs/PredictRLMNativeTrace"
        },
        "schema_version": {
          "const": 2,
          "default": 2,
          "title": "Schema Version",
          "type": "integer"
        },
        "turns": {
          "items": {
            "$ref": "#/$defs/Turn"
          },
          "title": "Turns",
          "type": "array"
        },
        "turns_streamed": {
          "title": "Turns Streamed",
          "type": "boolean"
        }
      },
      "required": [
        "schema_version",
        "header",
        "turns",
        "native",
        "turns_streamed"
      ],
      "title": "AgentTrace",
      "type": "object"
    },
    "AgentTraceFinished": {
      "additionalProperties": false,
      "description": "The final trace of an invocation; its turns travelled as live events.\n\n``complete`` says whether every live event of the invocation was delivered.",
      "properties": {
        "complete": {
          "title": "Complete",
          "type": "boolean"
        },
        "invocation_id": {
          "minLength": 1,
          "title": "Invocation Id",
          "type": "string"
        },
        "kind": {
          "const": "trace_finished",
          "default": "trace_finished",
          "title": "Kind",
          "type": "string"
        },
        "record": {
          "$ref": "#/$defs/AgentTrace"
        },
        "schema_version": {
          "const": 2,
          "default": 2,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "schema_version",
        "invocation_id",
        "record",
        "complete"
      ],
      "title": "AgentTraceFinished",
      "type": "object"
    },
    "AgentTraceHeader": {
      "additionalProperties": false,
      "description": "Summary every runtime reports for one agent invocation.",
      "properties": {
        "duration_ms": {
          "minimum": 0,
          "title": "Duration Ms",
          "type": "integer"
        },
        "external_run_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "External Run Id"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Model"
        },
        "runtime_kind": {
          "const": "predict_rlm",
          "title": "Runtime Kind",
          "type": "string"
        },
        "session_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Session Id"
        },
        "status": {
          "enum": [
            "succeeded",
            "failed",
            "cancelled"
          ],
          "title": "Status",
          "type": "string"
        },
        "stop_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Stop Reason"
        },
        "tool_call_count": {
          "minimum": 0,
          "title": "Tool Call Count",
          "type": "integer"
        },
        "trace_format": {
          "title": "Trace Format",
          "type": "string"
        },
        "turn_count": {
          "minimum": 0,
          "title": "Turn Count",
          "type": "integer"
        },
        "usage": {
          "anyOf": [
            {
              "$ref": "#/$defs/TokenUsage"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "runtime_kind",
        "trace_format",
        "status",
        "stop_reason",
        "model",
        "duration_ms",
        "usage",
        "turn_count",
        "tool_call_count",
        "external_run_id",
        "session_id"
      ],
      "title": "AgentTraceHeader",
      "type": "object"
    },
    "AgentTraceTerminal": {
      "discriminator": {
        "mapping": {
          "trace_finished": "#/$defs/AgentTraceFinished",
          "trace_unavailable": "#/$defs/AgentTraceUnavailable"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/AgentTraceFinished"
        },
        {
          "$ref": "#/$defs/AgentTraceUnavailable"
        }
      ]
    },
    "AgentTraceUnavailable": {
      "additionalProperties": false,
      "description": "An invocation that ended without a trace the runtime could export.",
      "properties": {
        "complete": {
          "title": "Complete",
          "type": "boolean"
        },
        "error": {
          "title": "Error",
          "type": "string"
        },
        "external_run_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "External Run Id"
        },
        "invocation_id": {
          "minLength": 1,
          "title": "Invocation Id",
          "type": "string"
        },
        "kind": {
          "const": "trace_unavailable",
          "default": "trace_unavailable",
          "title": "Kind",
          "type": "string"
        },
        "runtime_kind": {
          "const": "predict_rlm",
          "title": "Runtime Kind",
          "type": "string"
        },
        "schema_version": {
          "const": 2,
          "default": 2,
          "title": "Schema Version",
          "type": "integer"
        },
        "status": {
          "enum": [
            "succeeded",
            "failed",
            "cancelled"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "schema_version",
        "invocation_id",
        "runtime_kind",
        "status",
        "error",
        "external_run_id",
        "complete"
      ],
      "title": "AgentTraceUnavailable",
      "type": "object"
    },
    "CodeExecuted": {
      "additionalProperties": false,
      "properties": {
        "execution_error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Execution Error"
        },
        "format": {
          "const": "predict_rlm.run/v1",
          "default": "predict_rlm.run/v1",
          "title": "Format",
          "type": "string"
        },
        "iteration": {
          "minimum": 0,
          "title": "Iteration",
          "type": "integer"
        },
        "kind": {
          "const": "code.executed",
          "default": "code.executed",
          "title": "Kind",
          "type": "string"
        },
        "output": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Output"
        }
      },
      "required": [
        "format",
        "kind",
        "iteration",
        "output",
        "execution_error"
      ],
      "title": "CodeExecuted",
      "type": "object"
    },
    "CodeExecutionAction": {
      "additionalProperties": false,
      "description": "Code the agent wrote and executed during a turn.",
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Error"
        },
        "kind": {
          "const": "code_execution",
          "default": "code_execution",
          "title": "Kind",
          "type": "string"
        },
        "language": {
          "title": "Language",
          "type": "string"
        },
        "output": {
          "title": "Output",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "language",
        "code",
        "output",
        "error"
      ],
      "title": "CodeExecutionAction",
      "type": "object"
    },
    "CodeGenerated": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "kind": {
          "const": "code.generated",
          "default": "code.generated",
          "title": "Kind",
          "type": "string"
        },
        "turn": {
          "exclusiveMinimum": 0,
          "title": "Turn",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "turn",
        "code"
      ],
      "title": "CodeGenerated",
      "type": "object"
    },
    "Correlated": {

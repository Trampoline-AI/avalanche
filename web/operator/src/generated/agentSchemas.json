          "type": "string"
        },
        "kind": {
          "enum": [
            "predict.finished",
            "tool.started",
            "tool.finished",
            "code.generated"
          ],
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "format",
        "kind"
      ],
      "title": "Correlated",
      "type": "object"
    },
    "FieldDeclaration": {
      "additionalProperties": false,

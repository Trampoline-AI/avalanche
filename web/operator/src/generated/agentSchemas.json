    "PredictRLMModels": {
      "additionalProperties": false,
      "properties": {
        "main": {
          "anyOf": [
            {
              "$ref": "#/$defs/PredictRLMDefaultModel"
            },
            {
              "$ref": "#/$defs/PredictRLMConfiguredModel"
            }
          ],
          "title": "Main"
        },
        "sub": {

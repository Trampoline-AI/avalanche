    "JsonValue": {},
    "Lifecycle": {
      "additionalProperties": false,
      "description": "Sandbox and artifact lifecycle steps; Avalanche keeps only that they happened.",
      "properties": {
        "format": {
          "const": "predict_rlm.run/v1",
          "default": "predict_rlm.run/v1",
          "title": "Format",
          "type": "string"
        },
        "kind": {
          "enum": [
            "input.prepared",
            "session.started",
            "packages.installed",
            "artifact.mounted",
            "output.reserved",
            "artifact.collected",
            "output.materialized",
            "session.finalized",
            "session.finalize_failed",
            "session.released",
            "session.release_failed"
          ],
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "format",
        "kind"
      ],
      "title": "Lifecycle",
      "type": "object"
    },

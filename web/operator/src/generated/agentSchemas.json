      "properties": {
        "finish_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Finish Reason"
        },
        "format": {
          "const": "predict_rlm.run/v1",
          "default": "predict_rlm.run/v1",
          "title": "Format",
          "type": "string"
        },
        "iteration": {
          "minimum": 0,
          "title": "Iteration",
          "type": "integer"
        },
        "kind": {
          "const": "iteration.recorded",
          "default": "iteration.recorded",
          "title": "Kind",
          "type": "string"
        },
        "omissions": {
          "anyOf": [
            {
              "$ref": "#/$defs/PredictRLMOmissions"
